# Deployment-only values. Copy this file to .env; never commit the populated file.
SEPOLIA_RPC_URL=https://YOUR_SEPOLIA_RPC_ENDPOINT
DEPLOYER_PRIVATE_KEY=0xYOUR_DEMO_ONLY_PRIVATE_KEY
ALLOW_TESTNET_DEPLOY=false
SEPOLIA_CONFIRMATIONS=1

# Use four separate throwaway wallets. Do not use wallets that hold real assets.
DEMO_SELLER_ADDRESS=0xALICE_ADDRESS
DEMO_BUYER_ADDRESS=0xBOB_ADDRESS
DEMO_GATE_STAFF_ADDRESS=0xGATE_STAFF_ADDRESS
DEMO_METADATA_URI=https://YOUR_HTTPS_SITE/metadata.json

# Public frontend values to configure in Vercel. Never put a private key in REACT_APP_*.
REACT_APP_CHAIN_ID=0xaa36a7
REACT_APP_CHAIN_NAME=Sepolia
REACT_APP_RPC_URL=https://YOUR_SEPOLIA_RPC_ENDPOINT
REACT_APP_BLOCK_EXPLORER_URL=https://sepolia.etherscan.io
REACT_APP_CONTRACT_ADDRESS=0xDEPLOYED_CONTRACT_ADDRESS
REACT_APP_DEMO_SELLER_ADDRESS=0xALICE_ADDRESS
REACT_APP_DEMO_BUYER_ADDRESS=0xBOB_ADDRESS
REACT_APP_DEMO_GATE_STAFF_ADDRESS=0xGATE_STAFF_ADDRESS
